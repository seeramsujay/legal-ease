# ==============================================================================
# LEGAL-EASE PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# Fill in your API key below.
# 
# For Vercel Production Deployment:
# Add this variable in your Vercel Project Dashboard:
#   Vercel Dashboard -> Your Project -> Settings -> Environment Variables -> Add:
#     Key: GEMINI_API_KEY
#     Value: <your_google_ai_studio_api_key>
# Or using the Vercel CLI:
#   vercel env add GEMINI_API_KEY production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY LLM PROVIDER: GOOGLE GEMINI FLASH-LITE (RECOMMENDED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Get your free or paid Gemini API key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Target Gemini model identifier (fastest, high reasoning, lowest latency)
GEMINI_MODEL_NAME=gemini-2.0-flash-lite

# Google Gemini OpenAI-compatible base URL (default)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ------------------------------------------------------------------------------
# 2. ALTERNATIVE LLM PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# NVIDIA Nemotron 70B (from https://build.nvidia.com)
NVIDIA_API_KEY=
# NEMOTRON_API_KEY=
# NEMOTRON_MODEL_NAME=nvidia/llama-3.1-nemotron-70b-instruct
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI or generic OpenAI-compatible provider (OpenRouter, Together, Groq, Ollama)
OPENAI_API_KEY=
# OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. RUNTIME PIPELINE CONFIGURATION
# ------------------------------------------------------------------------------
# Active provider preset on boot: 'gemini', 'nemotron', or 'openai' (default: gemini)
LLM_PROVIDER=gemini

# Escalation confidence threshold (0.50 to 0.95, default: 0.75)
# Clauses with local confidence below this threshold or flagged with twisted
# drafting escalate to the active LLM for deep legal synthesis.
CONFIDENCE_THRESHOLD=0.75

# Host & port for local FastAPI server
HOST=0.0.0.0
PORT=8000
